---
import { Icon } from "astro-icon/components";
import BlogCard from "./atoms/BlogCard.astro";
import { getCollection } from "astro:content";
import { type Lang } from "@/types/i18n";
import { useTranslator } from "@/i18n/utils";
import { DEFAULT_LOCALE_SETTING } from "@/i18n/locales";
import {
  filterBlogEntriesByLocale,
  getBlogIndexHref,
  getBlogRouteInfo,
} from "@/utils/blogRouting";
import {
  compareBlogPostsByNewestDate,
  getVisibleBlogPosts,
} from "@/utils/blogPostDates";

const allPosts = getVisibleBlogPosts(
  await getCollection("blog"),
  import.meta.env.DEV,
);
const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE_SETTING;
const t = useTranslator(currentLocale as Lang);
const blogIndexHref = getBlogIndexHref(currentLocale);
---

<h2>{t("blog.recent-articles")}</h2>

<ul>
  {
    filterBlogEntriesByLocale(allPosts, currentLocale)
      .toSorted(compareBlogPostsByNewestDate)
      .slice(0, 12)
      .map((post: any) => (
        <li>
          <BlogCard
            title={post.data.title}
            desc={post.data.desc || t("blog.unset-description")}
            thumbnail={post.data.thumbnail || undefined}
            link={getBlogRouteInfo(post.id).href}
            date={post.data.date || ""}
            lastUpdate={post.data.lastUpdate || ""}
          />
        </li>
      ))
  }
</ul>

<a href={blogIndexHref}>{t("blog.all-articles-search")}<Icon name="mdi:arrow-right" /></a>

<style>
  h2 {
    margin: 220px 0 70px;
  }

  ul {
    list-style-type: none;
    padding: 0 20px;
    margin: 0 auto;
    display: grid;
    gap: 45px 16px;
    grid-template-columns: 1fr;
    max-width: 1920px;

    @media (min-width: 768px) {
      grid-template-columns: repeat(auto-fit, minmax(430px, 1fr));
    }
  }

  li {
    margin: 0 auto;
    font-size: 1.1em;
    width: 100%;
    height: 100%;
  }

  a {
    display: flex;
    margin: 60px 20px 120px;
    text-align: center;
    text-decoration: none;
    border: 2px solid var(--color-primary);
    justify-content: center;
    align-items: center;
    padding: 0.3lh 0;
    border-radius: 8px;
    transition: 0.2s;
  }

  a:hover {
    background-color: var(--color-primary);
    color: var(--color-background);
  }
</style>
