---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { DEFAULT_LOCALE, type Lang } from "@/types/i18n";
import { useTranslator } from "@/i18n/utils";
import {
  getBlogIndexHref,
  getLanguageSwitchHref,
  getParentPathHref,
} from "@/utils/blogRouting";
import { getVisibleBlogPosts } from "@/utils/blogPostDates";

const currentPath = Astro.url.pathname;
const currentLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Lang;
const t = useTranslator(currentLocale);
const iconSize = 30;
const parentHref = getParentPathHref(currentPath);
const blogHref = getBlogIndexHref(currentLocale);
const isHome = currentPath === "/" || currentPath === "/en/";
const targetLocale = currentLocale === "en" ? DEFAULT_LOCALE : "en";
const allPosts = getVisibleBlogPosts(
  await getCollection("blog"),
  import.meta.env.DEV,
);
const languageHref = getLanguageSwitchHref({
  pathname: currentPath,
  search: Astro.url.search,
  targetLocale,
  blogEntries: allPosts,
});
const languageIcon =
  currentLocale === "en" ? "twemoji:flag-japan" : "twemoji:flag-united-states";
const languageLabel =
  currentLocale === "en" ? t("header.switch-to-ja") : t("header.switch-to-en");
---

<header class="header-container">
  <div class="left">
    {
      !isHome && (
        <a href={parentHref}>
          <Icon
            name="carbon:folder-parent"
            width={iconSize}
            height={iconSize}
          />
          <span>{t("header.parent")}</span>
        </a>
      )
    }
  </div>
  <div class="right">
    <a href={blogHref}>
      <Icon name="carbon:blog" width={iconSize} height={iconSize} />
      <span>{t("header.blog")}</span>
    </a>
    <a href="/about/">
      <Icon name="carbon:help" width={iconSize} height={iconSize} />
      <span>{t("header.about")}</span>
    </a>
    <button id="themeToggle" aria-label="Toggle light and dark theme">
      <Icon
        class="sun"
        name="solar:sun-2-bold"
        width={iconSize}
        height={iconSize}
      />
      <Icon
        class="moon"
        name="solar:moon-bold"
        width={iconSize}
        height={iconSize}
      />
    </button>
    <a id="toggle-language" href={languageHref} aria-label={languageLabel}>
      <Icon name={languageIcon} width={iconSize} height={iconSize} />
      <span>{languageLabel}</span>
    </a>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const htmlElement = document.documentElement;
    const themeToggle = document.getElementById("themeToggle");
    if (!themeToggle) return;

    themeToggle.addEventListener("click", () => {
      const newTheme = htmlElement.classList.contains("dark")
        ? "light"
        : "dark";

      htmlElement.classList.toggle("dark", newTheme === "dark");
      localStorage.setItem("theme", newTheme);
    });
  });
</script>

<style>
  header.header-container {
    display: flex;
    justify-content: space-between;
  }

  div.left {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
  }

  div.right {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
  }

  button {
    padding: 0;
    display: flex;
    align-items: center;
  }

  /* Helper class to hide text visually but keep it for Screen Readers */
  span {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  #themeToggle {
    border: 0;
    background: none;
    cursor: pointer;
  }

  #toggle-language {
    color: var(--color-text);
  }

  .sun {
    color: black;
    display: none;
  }
  .moon {
    color: black;
    display: block;
  }

  :global(.dark) .sun {
    color: white;
    display: block;
  }
  :global(.dark) .moon {
    display: none;
  }
</style>
