---
import WorkCard from "./atoms/WorkCard.astro";
import moremobilityImage from "@/assets/homepage/works/moremobility_340.png";
import serverImage1 from "@/assets/homepage/works/server_1_340.jpg";
import partyparrotStreamdeckImage from "@/assets/homepage/works/partyparrot_streamdeck.png";
import craftskyImage from "@/assets/homepage/works/craftsky.png";
import typingImage from "@/assets/homepage/works/typing_340.jpg";
import mirinkuyan from "@/assets/homepage/works/mirinkuyan.jpg";
import profileIcon250 from "@/assets/profileicon250.png";
import stationSignGeneratorImage from "@/assets/homepage/works/station_sign_generator.png";
import passphraseGeneratorJapaneseImage from "@/assets/homepage/works/passphrase-generator-japanese.png";
import cpsresumeImage from "@/assets/homepage/works/cpsresume-square.jpg";
import ultitypeImage from "@/assets/homepage/works/ultitype.png";
import { type Lang } from "@/types/i18n";
import { useTranslator } from "@/i18n/utils";

const t = useTranslator(Astro.currentLocale as Lang);
---

<h2>{t("homepage.works.title")}</h2>

<section class="embla" id="works-embla">
  <div class="embla__viewport">
    <div class="embla__container">
      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.mirinkuyan.title")}
          imageSrc={mirinkuyan}
          link="https://twitter.com/intent/follow?region=follow_link&screen_name=ymag_h"
          linkText={t("homepage.works.mirinkuyan.link")}
        >
          {t("homepage.works.mirinkuyan.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.craftsky.title")}
          imageSrc={craftskyImage}
          link="https://crafters.aosankaku.net"
          linkText={t("homepage.works.craftsky.link")}
        >
          {t("homepage.works.craftsky.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.station-sign.title")}
          imageSrc={stationSignGeneratorImage}
          link="https://stationsigngen.aosankaku.net"
          linkText={t("homepage.works.station-sign.link")}
        >
          {t("homepage.works.station-sign.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.passphrase-generator-japanese.title")}
          imageSrc={passphraseGeneratorJapaneseImage}
          link="https://pasufure-zu.aosankaku.net"
          linkText={t("homepage.works.passphrase-generator-japanese.link")}
        >
          {t("homepage.works.passphrase-generator-japanese.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.ultitype.title")}
          imageSrc={ultitypeImage}
          link="https://ultitype.aosankaku.net"
          linkText={t("homepage.works.ultitype.link")}
        >
          {t("homepage.works.ultitype.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.cpsresume.title")}
          imageSrc={cpsresumeImage}
          link="https://cpsresume.aosankaku.net"
          linkText={t("homepage.works.cpsresume.link")}
        >
          {t("homepage.works.cpsresume.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.cpu.title")}
          imageSrc={partyparrotStreamdeckImage}
          link="https://github.com/AoSankaku/cpu-partyparrot/releases"
          linkText={t("homepage.works.cpu.link")}
        >
          {t("homepage.works.cpu.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title="Moremobility Mod"
          imageSrc={moremobilityImage}
          link="https://modrinth.com/mod/moremobility"
          linkText={t("homepage.works.moremobility.link")}
        >
          {t("homepage.works.moremobility.desc")}
        </WorkCard>
      </div>

      <div class="embla__slide">
        <WorkCard
          title={t("homepage.works.server.title")}
          imageSrc={serverImage1}
        >
          {t("homepage.works.server.desc")}
        </WorkCard>
      </div>
    </div>
  </div>
</section>

<style>
  .embla {
    --slide-spacing: 0px;
    --slide-size: 320px;
    --slide-height: 680px;

    margin: 60px 0;
    overflow: hidden;
    contain: layout paint;
    height: var(--slide-height);
  }

  @media (min-width: 768px) {
    .embla {
      --slide-spacing: 25px;
      --slide-size: 440px;
      --slide-height: 840px;
    }
  }

  .embla__viewport {
    overflow: hidden;
    height: 100%;
  }

  .embla__container {
    display: flex;
    height: 100%;
    backface-visibility: hidden;
    touch-action: pan-y;
    margin-left: calc(var(--slide-spacing) * -1);
  }

  .embla__slide {
    flex: 0 0 var(--slide-size);
    min-width: 0;
    padding-left: var(--slide-spacing);
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const target = document.querySelector("#works-embla");
    if (!target) return;

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;

        observer.disconnect();
        void initEmbla();
      },
      { rootMargin: "400px" },
    );

    observer.observe(target);

    async function initEmbla() {
      if (!target) return;

      const viewportNode =
        target.querySelector<HTMLElement>(".embla__viewport");
      if (!viewportNode || !viewportNode.isConnected) return;

      const [{ default: EmblaCarousel }, { default: Autoplay }] =
        await Promise.all([
          import("embla-carousel"),
          import("embla-carousel-autoplay"),
        ]);
      if (!viewportNode.isConnected) return;

      const embla = EmblaCarousel(
        viewportNode,
        { loop: true, align: "center", skipSnaps: false, duration: 30 },
        [Autoplay({ delay: 8000, stopOnInteraction: false })],
      );

      document.addEventListener("astro:before-swap", () => embla.destroy(), {
        once: true,
      });
    }

    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      {
        once: true,
      },
    );
  });
</script>
