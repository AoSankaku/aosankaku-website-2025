---
import ProfileInfoContainer from "../components/atoms/ProfileInfoContainer.astro";
import { type Lang } from "@/types/i18n";
import { useTranslator } from "@/i18n/utils";

const t = useTranslator(Astro.currentLocale as Lang);
---

<div class="container">
  <ProfileInfoContainer
    title={t("homepage.details.website-title")}
    icon="streamline-sharp:graphic-template-website-ui-remix"
  >
    <p>{t("homepage.details.website-desc")}</p>
  </ProfileInfoContainer>

  <ProfileInfoContainer
    title={t("homepage.details.dev-title")}
    icon="streamline-sharp:browser-code-2-solid"
  >
    <p>{t("homepage.details.dev-desc")}</p>
  </ProfileInfoContainer>

  <ProfileInfoContainer
    title={t("homepage.details.english-title")}
    icon="mdi:alphabet-e-box"
  >
    <p>{t("homepage.details.english-desc")}</p>
  </ProfileInfoContainer>

  <ProfileInfoContainer
    title={t("homepage.details.hobby-title")}
    icon="mdi:minecraft"
  >
    <p>{t("homepage.details.hobby-desc")}</p>
  </ProfileInfoContainer>

  <ProfileInfoContainer
    title={t("homepage.details.casual-title")}
    icon="fluent-emoji-high-contrast:call-me-hand"
  >
    <p>{t("homepage.details.casual-desc")}</p>
  </ProfileInfoContainer>

  <ProfileInfoContainer
    title={t("homepage.details.music-title")}
    icon="mdi:music-box-multiple-outline"
  >
    <p>{t("homepage.details.music-desc")}</p>
  </ProfileInfoContainer>
</div>

<style>
  .container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    max-width: 980px;
    margin: 110px auto 120px;
    padding: 0 20px;
    grid-row-gap: 30px;
  }

  p {
    color: var(--color-text-sub);
    margin: 0.3em 0 0 0;
  }
</style>
