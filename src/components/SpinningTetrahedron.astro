---
import {
  DRAW_HEIGHT_FRACTION,
  DRAW_TOP_FRACTION,
} from "../utils/tetrahedron-webgl.js";

const drawHeight = `${DRAW_HEIGHT_FRACTION * 100}%`;
const drawTop = `${DRAW_TOP_FRACTION * 100}%`;
---

<div
  class="tetrahedron-stage"
  style={`--draw-height: ${drawHeight}; --draw-top: ${drawTop}`}
>
  <canvas id="tetrahedron-canvas"></canvas>
</div>

<style>
  .tetrahedron-stage {
    position: relative;
    height: 250px;

    @media (min-width: 768px) {
      height: 400px;
    }
  }

  #tetrahedron-canvas {
    display: block;
    position: absolute;
    top: var(--draw-top);
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 256px);
    height: var(--draw-height);
    background-color: transparent;
  }
</style>

<script>
  const activeCanvases = new WeakMap<HTMLCanvasElement, TetrahedronController>();

  type Renderer = {
    resize(width: number, height: number, dpr: number): void;
    setTheme(isDark: boolean): void;
    setVisible(visible: boolean): void;
    setReducedMotion(reducedMotion: boolean): void;
    dispose(): void;
  };

  type TetrahedronController = {
    dispose(): void;
    start(): void;
  };

  class TetrahedronCanvasController implements TetrahedronController {
    private canvas: HTMLCanvasElement;
    private intersectionObserver: IntersectionObserver | null = null;
    private resizeObserver: ResizeObserver | null = null;
    private themeObserver: MutationObserver;
    private mediaQuery: MediaQueryList;
    private worker: Worker | null = null;
    private renderer: Renderer | null = null;
    private disposed = false;
    private started = false;
    private intersecting = false;
    private transferred = false;
    private backendGeneration = 0;
    private readonly onBeforeSwap = () => this.dispose();
    private readonly onDocumentVisibility = () => this.forwardVisibility();
    private readonly onViewportResize = () => this.forwardResize();
    private readonly onReducedMotionChange = (event: MediaQueryListEvent) => {
      this.forward({ type: "motion", reducedMotion: event.matches });
    };

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.mediaQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      this.themeObserver = new MutationObserver(() => {
        this.forward({
          type: "theme",
          isDark: document.documentElement.classList.contains("dark"),
        });
      });
    }

    start() {
      this.themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
      document.addEventListener("visibilitychange", this.onDocumentVisibility);
      document.addEventListener("astro:before-swap", this.onBeforeSwap, { once: true });
      window.addEventListener("resize", this.onViewportResize);
      this.observeCanvas();
      if (this.mediaQuery.addEventListener) {
        this.mediaQuery.addEventListener("change", this.onReducedMotionChange);
      } else {
        this.mediaQuery.addListener(this.onReducedMotionChange);
      }
    }

    private observeCanvas() {
      this.intersectionObserver?.disconnect();
      this.resizeObserver?.disconnect();

      if (typeof IntersectionObserver !== "undefined") {
        this.intersectionObserver = new IntersectionObserver((entries) => {
          const entry = entries.find((item) => item.target === this.canvas);
          if (!entry || this.disposed) return;
          this.intersecting = entry.isIntersecting;
          if (this.intersecting && !this.started) this.startBackend();
          this.forwardVisibility();
        }, { rootMargin: "0px" });
        this.intersectionObserver.observe(this.canvas);
      } else {
        this.intersecting = true;
        this.startBackend();
      }

      if (typeof ResizeObserver !== "undefined") {
        this.resizeObserver = new ResizeObserver(() => this.forwardResize());
        this.resizeObserver.observe(this.canvas);
      }
    }

    private dimensions() {
      const rect = this.canvas.getBoundingClientRect();
      return {
        width: Math.max(1, rect.width || this.canvas.offsetWidth),
        height: Math.max(1, rect.height || this.canvas.offsetHeight),
        dpr: this.devicePixelRatio(),
      };
    }

    private devicePixelRatio() {
      return 2;
    }

    private currentVisibility() {
      return this.intersecting && !document.hidden;
    }

    private startBackend() {
      if (this.disposed || this.started) return;
      this.started = true;

      const hasWorkerSupport =
        typeof OffscreenCanvas !== "undefined" &&
        typeof this.canvas.transferControlToOffscreen === "function" &&
        typeof Worker !== "undefined";

      if (hasWorkerSupport) this.startWorker();
      else this.startMainThread();
    }

    private startWorker() {
      const generation = ++this.backendGeneration;
      let worker: Worker;

      try {
        worker = new Worker(new URL("../workers/tetrahedron.worker.js", import.meta.url), {
          type: "module",
        });
      } catch {
        this.startMainThread();
        return;
      }

      this.worker = worker;
      worker.onmessage = (event: MessageEvent) => {
        if (this.disposed || this.worker !== worker || generation !== this.backendGeneration) return;
        if (event.data.type === "renderer-error" || event.data.type === "webgl-unsupported") {
          this.fallbackToMainThread(true);
        }
      };
      worker.onerror = () => {
        if (this.worker === worker) this.fallbackToMainThread(this.transferred);
      };
      worker.onmessageerror = () => {
        if (this.worker === worker) this.fallbackToMainThread(this.transferred);
      };

      try {
        const offscreen = this.canvas.transferControlToOffscreen();
        this.transferred = true;
        const size = this.dimensions();
        worker.postMessage(
          {
            type: "init",
            canvas: offscreen,
            ...size,
            isDark: document.documentElement.classList.contains("dark"),
            reducedMotion: this.mediaQuery.matches,
            visible: this.currentVisibility(),
          },
          [offscreen],
        );
      } catch {
        this.fallbackToMainThread(this.transferred);
      }
    }

    private async startMainThread() {
      if (this.disposed) return;
      const generation = ++this.backendGeneration;

      try {
        const { createTetrahedronRenderer } = await import("../utils/tetrahedron-renderer.js");
        if (this.disposed || generation !== this.backendGeneration || !this.canvas.isConnected) return;

        const renderer = createTetrahedronRenderer(this.canvas, {
          ...this.dimensions(),
          isDark: document.documentElement.classList.contains("dark"),
          reducedMotion: this.mediaQuery.matches,
          visible: this.currentVisibility(),
        });

        if (this.disposed || generation !== this.backendGeneration) {
          renderer.dispose();
          return;
        }
        this.renderer = renderer;
      } catch {
        // Keep the rest of the page usable when WebGL is unavailable.
      }
    }

    private fallbackToMainThread(replaceTransferredCanvas: boolean) {
      if (this.disposed) return;
      this.worker?.terminate();
      this.worker = null;

      if (replaceTransferredCanvas) {
        const oldCanvas = this.canvas;
        const replacement = oldCanvas.cloneNode(false) as HTMLCanvasElement;
        oldCanvas.replaceWith(replacement);
        activeCanvases.delete(oldCanvas);
        this.canvas = replacement;
        activeCanvases.set(replacement, this);
        this.transferred = false;
        this.observeCanvas();
      }

      this.startMainThread();
    }

    private forward(message: Record<string, unknown>) {
      if (this.disposed) return;
      if (this.renderer) {
        if (message.type === "theme") this.renderer.setTheme(message.isDark as boolean);
        else if (message.type === "motion") this.renderer.setReducedMotion(message.reducedMotion as boolean);
        else if (message.type === "visibility") this.renderer.setVisible(message.visible as boolean);
      } else if (this.worker) {
        try {
          this.worker.postMessage(message);
        } catch {
          this.fallbackToMainThread(this.transferred);
        }
      }
    }

    private forwardVisibility() {
      this.forward({ type: "visibility", visible: this.currentVisibility() });
    }

    private forwardResize() {
      if (this.disposed) return;
      const { width, height, dpr } = this.dimensions();
      if (this.renderer) this.renderer.resize(width, height, dpr);
      else if (this.worker) {
        try {
          this.worker.postMessage({ type: "resize", width, height, dpr });
        } catch {
          this.fallbackToMainThread(this.transferred);
        }
      }
    }

    dispose() {
      if (this.disposed) return;
      this.disposed = true;
      this.backendGeneration += 1;
      this.intersectionObserver?.disconnect();
      this.resizeObserver?.disconnect();
      this.themeObserver.disconnect();
      document.removeEventListener("visibilitychange", this.onDocumentVisibility);
      document.removeEventListener("astro:before-swap", this.onBeforeSwap);
      window.removeEventListener("resize", this.onViewportResize);
      if (this.mediaQuery.removeEventListener) {
        this.mediaQuery.removeEventListener("change", this.onReducedMotionChange);
      } else {
        this.mediaQuery.removeListener(this.onReducedMotionChange);
      }
      this.renderer?.dispose();
      this.renderer = null;
      this.worker?.terminate();
      this.worker = null;
      activeCanvases.delete(this.canvas);
    }
  }

  const initializeTetrahedron = () => {
    const canvas = document.getElementById("tetrahedron-canvas") as HTMLCanvasElement | null;
    if (!canvas || activeCanvases.has(canvas)) return;

    const controller = new TetrahedronCanvasController(canvas);
    activeCanvases.set(canvas, controller);
    controller.start();
  };

  document.addEventListener("astro:page-load", initializeTetrahedron);
</script>
