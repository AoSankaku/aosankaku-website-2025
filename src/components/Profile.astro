---
import ProfileInfoContainer from "./atoms/ProfileInfoContainer.astro";
import { type Lang } from "@/types/i18n";
import { useTranslator } from "@/i18n/utils";

const t = useTranslator(Astro.currentLocale as Lang);
---

<div class="container">
  <ProfileInfoContainer
    title={t("homepage.profile.basic-title")}
    icon="carbon:user-profile-alt"
    boxType="large"
  >
    <ul>
      <li>{t("homepage.profile.nickname")}</li>
      <li>{t("homepage.profile.gender")}</li>
      <li>{t("homepage.profile.age")}</li>
      <li>{t("homepage.profile.job")}</li>
    </ul>
  </ProfileInfoContainer>
</div>

<style>
  .container {
    margin-top: 80px;
  }

  ul {
    list-style: none;
    padding: 10px;
    margin: 0;
    text-align: left;
  }

  li {
    margin-bottom: 8px;
    text-indent: -3em;
    padding-left: 4em;
  }
</style>
