---
// Blog article list page (/blog/)
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BlogCard from "@/components/atoms/BlogCard.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import categoryIcons, { getIcon } from "@/consts/categoryIcons";

import { useTranslator } from "@/i18n/utils";
import { type Lang } from "@/types/i18n";
import { DEFAULT_LOCALE_SETTING } from "@/i18n/locales";
import {
  filterBlogEntriesByLocale,
  getBlogRouteInfo,
} from "@/utils/blogRouting";
import {
  compareBlogPostsByNewestDate,
  getVisibleBlogPosts,
} from "@/utils/blogPostDates";

const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE_SETTING;
const allPosts = filterBlogEntriesByLocale(
  getVisibleBlogPosts(await getCollection("blog"), import.meta.env.DEV),
  currentLocale,
);

// Sort
allPosts.sort(compareBlogPostsByNewestDate);

// Category Logic
const categoryOrder = Object.keys(categoryIcons);

const isDev = import.meta.env.DEV;
const rawCategories = [
  ...new Set(allPosts.map((post) => post.data.category || "Uncategorized")),
];

const categories = rawCategories
  .filter((cat) => isDev || cat.toLowerCase() !== "uncategorized")
  .sort((a, b) => {
    // Sort based on the index in categoryOrder, or push to end if not found
    const indexA = categoryOrder.indexOf(a);
    const indexB = categoryOrder.indexOf(b);
    return (indexA > -1 ? indexA : 99) - (indexB > -1 ? indexB : 99);
  });

// 1. Calculate tag occurrences
const tagCountMap: Record<string, number> = {};
allPosts.forEach((post) => {
  post.data.tags?.forEach((tag: string) => {
    tagCountMap[tag] = (tagCountMap[tag] || 0) + 1;
  });
});

// 2. Sort tags by occurrence (descending), then alphabetically
const sortedTags = Object.keys(tagCountMap).sort((a, b) => {
  const countDiff = tagCountMap[b] - tagCountMap[a];
  return countDiff !== 0 ? countDiff : a.localeCompare(b);
});

const t = useTranslator(currentLocale as Lang);
---

<Layout title={t("blog.all-articles")}>
  <Header />
  <div class="container">
    <h1>{t("blog.all-articles")}</h1>

    <p>{t("blog.search-articles")}</p>
    <input
      type="text"
      id="searchInput"
      placeholder={t("blog.search-placeholder")}
      style="width: 100%; padding: 8px; margin-bottom: 8px; box-sizing: border-box;"
    />

    <details id="filterDetails">
      <summary id="summary">
        <p class="filter-desc">
          <Icon name="mdi:filter-variant" size="1.4em" />
          <span>{t("blog.filter")}</span>
          <span
            id="activeFilterCount"
            class="filter-badge"
            style="display: none;">0</span
          >
        </p>
        <button id="clearTags"
          ><Icon name="mdi:trash" size="2em" /> {t("blog.reset-all")}</button
        >
      </summary>

      <div class="filter-section">
        <p class="filter-label">{t("blog.category")}</p>
        <div id="categoryFilters">
          {
            categories.map((cat) => (
              <button class="category-button" data-category={cat}>
                {/* Make sure this line looks exactly like this */}
                <Icon name={getIcon(cat)} />
                <span>{cat}</span>
              </button>
            ))
          }
        </div>

        <p class="filter-label">{t("blog.tags")}</p>
        <div id="tagFilters">
          {
            sortedTags.map((tag) => (
              <button class="tag-button" data-tag={tag}>
                #{tag} <span class="tag-count">({tagCountMap[tag]})</span>
              </button>
            ))
          }
        </div>
        <button id="closeSummary"
          ><Icon name="mdi:chevron-up" size="1.5em" />{t("blog.collapse")}</button
        >
      </div>
    </details>

    <fieldset class="view-mode-selector">
      <legend>{t("blog.view-mode")}</legend>
      <div class="view-mode-buttons">
        <button
          type="button"
          class="view-mode-button"
          data-view-mode="list"
          aria-pressed="false"
        >
          <Icon name="mdi:format-list-bulleted" size="1.25em" />
          <span>{t("blog.view-list")}</span>
        </button>
        <button
          type="button"
          class="view-mode-button"
          data-view-mode="image-list"
          aria-pressed="true"
        >
          <Icon name="mdi:view-agenda-outline" size="1.25em" />
          <span>{t("blog.view-image-list")}</span>
        </button>
        <button
          type="button"
          class="view-mode-button"
          data-view-mode="cards"
          aria-pressed="false"
        >
          <Icon name="mdi:view-grid-outline" size="1.25em" />
          <span>{t("blog.view-cards")}</span>
        </button>
      </div>
    </fieldset>

    <ul id="postList" data-view-mode="image-list">
      {
        allPosts.map((post) => (
          <li
            class="post-entry"
            data-title={post.data.title}
            data-tags={(post.data.tags || []).join(",")}
            data-category={post.data.category || "uncategorized"}
          >
            <div class="post-view post-card-view">
              <BlogCard
                title={post.data.title}
                desc={post.data.desc || t("blog.unset-description")}
                thumbnail={post.data.thumbnail || ""}
                link={getBlogRouteInfo(post.id).href}
                postId={post.id}
                date={post.data.date.toISOString()}
                lastUpdate={post.data.lastUpdate?.toISOString()}
              />
            </div>
          </li>
        ))
      }
    </ul>

    <div id="nothingFound">
      <Icon name="twemoji:person-shrugging" size="64px" />
      <p>
        {t("blog.nothing-found")}<br />{t("blog.nothing-found-desc")}
      </p>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  div.container {
    margin: 80px max(20px, 5%) 200px;
  }

  .view-mode-selector {
    border: 0;
    margin: 0 0 24px;
    padding: 0;
  }

  .view-mode-selector legend {
    color: var(--color-text-sub);
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .view-mode-buttons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 640px;
    border: 1px solid var(--color-text-sub);
    border-radius: 8px;
    overflow: hidden;
  }

  .view-mode-button {
    min-height: 44px;
    padding: 8px 12px;
    border: 0;
    border-right: 1px solid var(--color-text-sub);
    background: var(--color-background-sub);
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font: inherit;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .view-mode-button:last-child {
    border-right: 0;
  }

  .view-mode-button:hover {
    background: var(--color-card);
  }

  .view-mode-button[aria-pressed="true"] {
    background: var(--color-text);
    color: var(--color-background);
  }

  .view-mode-button:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: -3px;
  }

  #postList {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-view {
    display: none;
  }

  #postList[data-view-mode="list"] {
    list-style: disc;
    padding-left: 2rem;
  }

  #postList[data-view-mode="list"] .post-entry {
    margin: 0.4rem 0;
  }

  .post-card-view {
    display: block;
  }

  #postList[data-view-mode="list"] .post-card-view {
    height: auto;
  }

  #postList[data-view-mode="list"] .post-card-view > :global(a) {
    display: inline;
    width: auto;
    height: auto;
    border-radius: 0;
    color: var(--color-primary);
    text-decoration: underline;
  }

  #postList[data-view-mode="list"] .post-card-view > :global(a:hover) {
    box-shadow: none;
  }

  #postList[data-view-mode="list"] :global(.blog-card) {
    display: inline;
    height: auto;
    padding: 0;
    border-radius: 0;
    background: transparent;
    text-align: left;
  }

  #postList[data-view-mode="list"] :global(.blog-card > img),
  #postList[data-view-mode="list"] :global(.blog-card > .desc),
  #postList[data-view-mode="list"] :global(.blog-card > .date-container) {
    display: none;
  }

  #postList[data-view-mode="list"] :global(.blog-title) {
    display: inline;
    min-height: 0;
    margin: 0;
    padding: 0;
    font-size: inherit;
    font-weight: normal;
    line-height: normal;
  }

  #postList[data-view-mode="image-list"] {
    max-width: 768px;
    margin-inline: auto;
  }

  #postList[data-view-mode="image-list"] .post-card-view {
    height: 80px;
    margin: 10px 0;
  }

  #postList[data-view-mode="image-list"] .post-card-view > :global(a) {
    height: 80px;
    border-radius: 8px;
  }

  #postList[data-view-mode="image-list"] .post-card-view > :global(a:hover) {
    box-shadow: none;
  }

  #postList[data-view-mode="image-list"] :global(.blog-card) {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    align-items: center;
    height: 80px;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-text-sub);
    border-radius: 8px;
    background: transparent;
    text-align: left;
  }

  #postList[data-view-mode="image-list"]
    .post-card-view
    > :global(a:hover .blog-card) {
    background: var(--color-card);
  }

  #postList[data-view-mode="image-list"] :global(.blog-card > img) {
    width: 120px;
    height: 80px;
    margin: 0;
    border-radius: 8px 0 0 8px;
    aspect-ratio: auto;
    object-fit: cover;
  }

  #postList[data-view-mode="image-list"] :global(.blog-title) {
    display: -webkit-box;
    justify-content: flex-start;
    min-height: 0;
    margin: 0;
    padding-left: 0;
    padding-right: 8px;
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: bold;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  #postList[data-view-mode="image-list"] :global(.blog-card > .desc),
  #postList[data-view-mode="image-list"]
    :global(.blog-card > .date-container) {
    display: none;
  }

  #postList[data-view-mode="cards"] {
    display: grid;
    grid-template-columns: 1fr;
    gap: 45px 16px;
    max-width: 1920px;
    margin-inline: auto;
  }

  #postList[data-view-mode="cards"] .post-entry,
  #postList[data-view-mode="cards"] .post-card-view {
    width: 100%;
    height: 100%;
  }

  #filterDetails {
    background: var(--color-card);
    border-radius: 16px;
    user-select: none;
    border: 2px solid var(--color-text-sub);
    padding: 10px;
    margin: 16px 0 30px 0;
  }

  #tagFilters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 24px 0 44px 0;
  }

  #clearTags {
    background: none;
    border: 2px solid var(--color-text-sub);
    border-radius: 6px;
    cursor: pointer;
    font-size: 1em;
    color: var(--color-text-sub);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    line-height: 1.8em;
  }

  .tag-button {
    transition:
      opacity 0.2s ease,
      transform 0.1s ease;
    padding: 4px 12px;
    border-radius: 16px;
    border: 2px solid var(--color-text-sub);
    background: transparent;
    cursor: pointer;
    font-size: 0.85em;
    color: var(--color-text);
    height: 32px;
  }

  .tag-count {
    color: var(--color-text-sub);
    font-size: 0.9em;
  }

  .tag-button.active {
    background: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-text-sub);

    .tag-count {
      color: var(--color-background);
    }
  }

  #nothingFound {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  summary {
    list-style-type: none;
    cursor: pointer;
    border-radius: 16px;
    padding: 0.3em 0;
    display: flex;
    justify-content: center;
    align-items: center;
    column-gap: 40px;
    row-gap: 12px;
    flex-wrap: wrap;
  }

  .filter-desc {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
  }

  .filter-badge {
    background: var(--color-primary);
    color: var(--color-background);
    font-weight: bold;
    font-size: 0.7em;
    padding: 0px 8px;
    border-radius: 10px;
    margin-left: 8px;
    vertical-align: middle;
    aspect-ratio: 1 / 1;
  }

  .filter-label {
    font-size: 0.8em;
    font-weight: bold;
    margin: 16px 0 8px 0;
    color: var(--color-text-sub);
  }

  #categoryFilters {
    display: flex;
    gap: 0px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    border: 1px solid var(--color-text-sub);
    justify-content: space-evenly;
  }

  .category-button {
    flex: 1 1 0px;
    padding: 8px 16px; /* Increased padding slightly for icons */
    min-width: 200px;
    border: 1px solid var(--color-text);
    background: var(--color-background-sub);
    cursor: pointer;
    font-size: 1.1em; /* Adjusted font size for better icon/text balance */
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  /* Target the icon specifically within the button */
  .category-button [data-icon] {
    font-size: 1.2em;
    color: var(--color-primary); /* Or your preferred accent color */
  }

  .category-button.active {
    background: var(--color-text);
    color: var(--color-background);
  }

  .category-button.active [data-icon] {
    color: var(--color-background); /* Icon matches text color when active */
  }

  #closeSummary {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20px auto;
    padding: 6px 12px;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .view-mode-button {
      flex-direction: column;
      gap: 2px;
      padding-inline: 4px;
      font-size: 0.75rem;
    }

    #postList[data-view-mode="image-list"] :global(.blog-card) {
      grid-template-columns: 80px 1fr;
    }

    #postList[data-view-mode="image-list"] :global(.blog-card > img) {
      width: 80px;
    }

    .category-button {
      font-size: 0.9em;
      padding: 6px 10px;
    }
  }

  /* Responsive Shrinking */
  @media (max-width: 600px) {
    .tag-button {
      font-size: 0.75em;
      padding: 2px 8px;
      height: 28px;
    }
  }

  @media (min-width: 768px) {
    #postList[data-view-mode="cards"] {
      grid-template-columns: repeat(auto-fit, minmax(430px, 1fr));
    }
  }
</style>

<script>
  import "../../utils/prototypes";

  document.addEventListener("astro:page-load", () => {
  const searchInput = document.getElementById(
    "searchInput",
  ) as HTMLInputElement | null;
  if (!searchInput) return;

  const tagButtons = document.querySelectorAll(".tag-button");
  const catButtons = document.querySelectorAll(".category-button");
  const filterBadge = document.getElementById("activeFilterCount");
  const closeSummary = document.getElementById("closeSummary");
  const summary = document.getElementById("summary");
  const postListElement = document.getElementById("postList");
  const postList = document.querySelectorAll("#postList > .post-entry");
  const viewModeButtons =
    document.querySelectorAll<HTMLButtonElement>(".view-mode-button");
  const nothingFound = document.getElementById("nothingFound");

  type ViewMode = "list" | "image-list" | "cards";
  const viewModeStorageKey = "blog-view-mode";
  const defaultViewMode: ViewMode = "image-list";
  const isViewMode = (value: string | null): value is ViewMode =>
    value === "list" || value === "image-list" || value === "cards";

  const applyViewMode = (viewMode: ViewMode) => {
    if (!postListElement) return;

    postListElement.dataset.viewMode = viewMode;
    viewModeButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.viewMode === viewMode),
      );
    });
  };

  let initialViewMode = defaultViewMode;
  try {
    const savedViewMode = localStorage.getItem(viewModeStorageKey);
    if (isViewMode(savedViewMode)) initialViewMode = savedViewMode;
  } catch {
    // Storage can be unavailable in strict privacy modes.
  }
  applyViewMode(initialViewMode);

  viewModeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const viewMode = button.dataset.viewMode;
      if (!isViewMode(viewMode)) return;

      applyViewMode(viewMode);
      try {
        localStorage.setItem(viewModeStorageKey, viewMode);
      } catch {
        // Keep the current-page selection even when storage is unavailable.
      }
    });
  });

  const getUrlActiveTags = () => {
    const searchParams = new URLSearchParams(window.location.search);
    return Array.from(
      new Set(searchParams.getAll("tag").filter((tag) => tag.trim() !== "")),
    );
  };

  const updateUrlActiveTags = () => {
    const searchParams = new URLSearchParams(window.location.search);
    searchParams.delete("tag");
    activeTags.forEach((tag) => searchParams.append("tag", tag));

    const query = searchParams.toString();
    const nextUrl = `${window.location.pathname}${query ? `?${query}` : ""}${
      window.location.hash
    }`;
    window.history.replaceState(window.history.state, "", nextUrl);
  };

  const urlActiveTags = getUrlActiveTags();
  let activeTags: string[] =
    urlActiveTags.length > 0
      ? urlActiveTags
      : JSON.parse(sessionStorage.getItem("blog-active-tags") || "[]");
  let activeCategory =
    urlActiveTags.length > 0
      ? ""
      : sessionStorage.getItem("blog-active-cat") || "";

  const filterArticles = () => {
    let hasVisible = false;
    const searchText = searchInput.value.toLowerCase().toKatakana();

    // 1. Save state
    sessionStorage.setItem("blog-search-query", searchInput.value);
    sessionStorage.setItem("blog-active-tags", JSON.stringify(activeTags));
    sessionStorage.setItem("blog-active-cat", activeCategory);
    updateUrlActiveTags();

    // 2. Dynamic Tag Count Logic
    // We create a temporary map to count tags available within the current category + search
    const currentTagCounts: Record<string, number> = {};

    postList.forEach((post) => {
      const el = post as HTMLElement;
      const title = el.dataset.title?.toLowerCase().toKatakana() || "";
      const cat = el.dataset.category || "uncategorized";
      const tags = el.dataset.tags?.split(",") || [];

      // Check if article matches Category AND Search (ignoring current tags for count purposes)
      const matchesSearch = title.includes(searchText);
      const matchesCat = activeCategory === "" || cat === activeCategory;

      if (matchesSearch && matchesCat) {
        tags.forEach((t) => {
          if (t) currentTagCounts[t] = (currentTagCounts[t] || 0) + 1;
        });
      }

      // 3. Final Visibility Logic (Must match all 3 criteria)
      const matchesTags =
        activeTags.length === 0 || activeTags.every((t) => tags.includes(t));
      const isVisible = matchesSearch && matchesTags && matchesCat;

      el.style.display = isVisible ? "" : "none";
      if (isVisible) hasVisible = true;
    });

    // 4. Update Tag Button UI (Hide/Disable tags with 0 matches)
    tagButtons.forEach((btn) => {
      const tag = (btn as HTMLElement).dataset.tag || "";
      const count = currentTagCounts[tag] || 0;
      const countSpan = btn.querySelector(".tag-count");

      if (countSpan) countSpan.textContent = `(${count})`;

      // Hide or Disable tags that have no articles in this category/search
      // Note: We keep active tags visible even if count is 0 so the user can deselect them
      if (count === 0 && !activeTags.includes(tag)) {
        (btn as HTMLElement).style.display = "none";
      } else {
        (btn as HTMLElement).style.display = "";
        btn.classList.toggle("active", activeTags.includes(tag));
      }
    });

    // 5. Update Badge & Category UI
    const totalFilters = activeTags.length + (activeCategory ? 1 : 0);
    if (filterBadge) {
      filterBadge.textContent = totalFilters.toString();
      filterBadge.style.display = totalFilters > 0 ? "inline" : "none";
    }

    catButtons.forEach((btn) =>
      btn.classList.toggle(
        "active",
        (btn as HTMLElement).dataset.category === activeCategory,
      ),
    );

    nothingFound?.style.setProperty("display", hasVisible ? "none" : "flex");
  };

  // Category Clicks (Single Select)
  catButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cat = (btn as HTMLElement).dataset.category || "";
      activeCategory = activeCategory === cat ? "" : cat;
      filterArticles();
    });
  });

  // Tag Clicks (Multi Select) - logic remains the same
  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = (btn as HTMLElement).dataset.tag || "";
      activeTags = activeTags.includes(tag)
        ? activeTags.filter((t) => t !== tag)
        : [...activeTags, tag];
      filterArticles();
    });
  });

  document.getElementById("clearTags")?.addEventListener("click", () => {
    activeTags = [];
    activeCategory = "";
    searchInput.value = "";
    filterArticles();
  });
  // 2. Variables activeTags and activeCategory were already restored
  // at the top of the script during declaration.

  // 3. Trigger the filter immediately to sync the UI with restored values
  // This now has access to the searchInput.value we just restored.
  filterArticles();

  // 4. Handle Safari/Mobile Back-Forward Cache (BFCache)
  const pageShowController = new AbortController();
  window.addEventListener(
    "pageshow",
    (event) => {
      if (!event.persisted) return;

      const persistedUrlTags = getUrlActiveTags();

      if (persistedUrlTags.length > 0) {
        activeTags = persistedUrlTags;
        activeCategory = "";
        searchInput.value = "";
      } else {
        const persistedSearch = sessionStorage.getItem("blog-search-query");
        if (persistedSearch !== null) searchInput.value = persistedSearch;

        activeTags = JSON.parse(
          sessionStorage.getItem("blog-active-tags") || "[]",
        );
        activeCategory = sessionStorage.getItem("blog-active-cat") || "";
      }

      filterArticles();
    },
    { signal: pageShowController.signal },
  );
  document.addEventListener(
    "astro:before-swap",
    () => pageShowController.abort(),
    { once: true },
  );

  searchInput?.addEventListener("input", () => {
    filterArticles();
  });

  closeSummary?.addEventListener("click", () => {
    summary?.click();
  });
  });
</script>
