---
import { getCollection, render } from "astro:content";
import BlogArticleLayout from "@/layouts/BlogArticleLayout.astro";
import {
  getBlogRouteInfo,
  isDefaultLocaleBlogEntry,
} from "@/utils/blogRouting";
import { getVisibleBlogPosts } from "@/utils/blogPostDates";

export async function getStaticPaths() {
  const posts = getVisibleBlogPosts(
    await getCollection("blog"),
    import.meta.env.DEV,
  );

  return posts.filter((post) => isDefaultLocaleBlogEntry(post.id)).map((post) => {
    const routeInfo = getBlogRouteInfo(post.id);

    return {
      params: { slug: routeInfo.slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const routeInfo = getBlogRouteInfo(post.id);
const { Content, headings } = await render(post);
---

<BlogArticleLayout
  frontmatter={post.data}
  headings={headings}
  slug={routeInfo.slug}
  postId={post.id}
>
  <Content />
</BlogArticleLayout>
