---
import { getCollection, render } from "astro:content";
import BlogArticleLayout from "@/layouts/BlogArticleLayout.astro";
import {
  getBlogRouteInfo,
  isDefaultLocaleBlogEntry,
} from "@/utils/blogRouting";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts
    .filter((post) => !isDefaultLocaleBlogEntry(post.id))
    .map((post) => {
      const routeInfo = getBlogRouteInfo(post.id);

      return {
        params: { lang: routeInfo.locale, slug: routeInfo.slug },
        props: { post },
      };
    });
}

const { post } = Astro.props;
const routeInfo = getBlogRouteInfo(post.id);
const { Content, headings } = await render(post);
---

<BlogArticleLayout
  frontmatter={post.data}
  headings={headings}
  slug={routeInfo.slug}
  postId={post.id}
>
  <Content />
</BlogArticleLayout>
