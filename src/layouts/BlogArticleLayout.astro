---
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import formatToJSTDate from "@/utils/formatToJSTDate";
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";
import { getIcon } from "@/consts/categoryIcons";
import ShareButtons from "@/components/ShareButtons.astro";
import GooglePreferredSourceButton from "@/components/GooglePreferredSourceButton.astro";
import RelatedArticles from "@/components/atoms/RelatedArticles.astro";
import { useTranslator } from "@/i18n/utils";
import type { Lang } from "@/types/i18n";
import "remark-github-alerts/styles/github-base.css";
import "@/styles/blogArticleStyle.css";
import getArticleImage, {
  getDefaultArticleImage,
} from "@/utils/getArticleImage";
import NextPrevPosts from "@/components/atoms/NextPrevPosts.astro";
import {
  getBlogIndexTagFilterHref,
  getBlogRouteInfo,
} from "@/utils/blogRouting";

interface Props {
  frontmatter: any;
  headings: MarkdownHeading[];
  slug?: string;
  postId?: string;
}

const { frontmatter, headings, slug, postId = slug } = Astro.props;
const routeInfo = postId ? getBlogRouteInfo(postId) : null;
const articleLocale = (routeInfo?.locale ?? Astro.currentLocale) as Lang;
const tagFilterLocale = articleLocale;
const t = useTranslator(articleLocale);

// When the slug is undefined, this article doesn't belong to /blog/
const articleImage = slug
  ? await getArticleImage(postId ?? slug, frontmatter.thumbnail)
  : frontmatter.thumbnail
    ? frontmatter.thumbnail // Use the specified fetchable thumbnail if exists
    : getDefaultArticleImage(); // Use the default thumbnail if blank

const articleDate = formatToJSTDate(frontmatter.date);
const originalDate = frontmatter.originalDate
  ? formatToJSTDate(frontmatter.originalDate)
  : null;
const lastUpdate = frontmatter.lastUpdate
  ? formatToJSTDate(frontmatter.lastUpdate)
  : null;
const toDateTime = (date: string | Date) => {
  const parsedDate = new Date(date);
  return isNaN(parsedDate.getTime()) ? undefined : parsedDate.toISOString();
};
const articleDateTime = toDateTime(frontmatter.date);
const originalDateTime = frontmatter.originalDate
  ? toDateTime(frontmatter.originalDate)
  : undefined;
const lastUpdateDateTime = frontmatter.lastUpdate
  ? toDateTime(frontmatter.lastUpdate)
  : undefined;

// TOC generation

const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

<Layout
  title={frontmatter.title}
  description={frontmatter.desc}
  type="article"
  ogpImage={articleImage}
>
  <Header />
  <div class="blog-hero">
    <Image
      src={articleImage}
      alt={frontmatter.alt || ""}
      width={1280}
      height={720}
      loading="eager"
    />
    <p class="category">
      <Icon name={getIcon(frontmatter.category)} size="1.2em" />{
        frontmatter.category
      }
    </p>
    <h1>{frontmatter.title}</h1>
    <p class="desc">{frontmatter.desc}</p>
    <div class="date-container">
      {
        originalDate && (
          <span
            class="date-item date-item-hint"
            title="original date"
            aria-label={`original date: ${originalDate}`}
          >
            <Icon name="mdi:calendar-start" size="1.1em" />
            <time class="date" datetime={originalDateTime}>
              {originalDate}
            </time>
          </span>
        )
      }
      <span class="date-item">
        <Icon name="mdi:calendar" size="1.1em" />
        <time class="date" datetime={articleDateTime}>{articleDate}</time>
      </span>
      {
        lastUpdate && (
          <span class="date-item">
            <Icon name="mdi:update" size="1.1em" />
            <time class="date" datetime={lastUpdateDateTime}>
              {lastUpdate}
            </time>
          </span>
        )
      }
    </div>
  </div>
  <div class="container" data-toc={JSON.stringify(toc)}>
    <ShareButtons
      title={frontmatter.title}
      locale={articleLocale}
      variant="compact"
    />
    <slot />
  </div>
  {postId && <RelatedArticles postId={postId} locale={articleLocale} />}

  {
    frontmatter.tags && (
      <div class="tags">
        <h3>{t("blog.article-tags")}</h3>
        {frontmatter.tags.map((tag: string) => (
          <a class="tag" href={getBlogIndexTagFilterHref(tag, tagFilterLocale)}>
            <Icon name="mdi:tag" size="0.8em" />
            {tag}
          </a>
        ))}
      </div>
    )
  }
  <ShareButtons title={frontmatter.title} locale={articleLocale} />
  <GooglePreferredSourceButton locale={articleLocale} />
  {postId && <NextPrevPosts postId={postId} />}
  <Footer />
</Layout>

<script>
  function setupTableOfContents() {
    const container = document.getElementById("article-toc-trigger");
    if (!container || container.dataset.tocInitialized === "true") return;

    const articleContainer = container.closest<HTMLElement>("[data-toc]");
    const toc = JSON.parse(articleContainer?.dataset.toc ?? "[]") as Array<{
      depth: number;
      slug: string;
      text: string;
    }>;
    if (toc.length === 0) return;

    container.dataset.tocInitialized = "true";
    const title = document.createElement("h2");
    title.innerText = "Table of Contents";

    const list = document.createElement("ul");
    toc.forEach((h) => {
      const li = document.createElement("li");
      li.style.marginLeft = `${(h.depth - 2) * 20}px`;
      const a = document.createElement("a");
      a.href = `#${h.slug}`;

      // --- Emoji Integration ---
      // Find the actual heading in the article using the slug
      const actualHeading = document.getElementById(h.slug);
      if (actualHeading) {
        // Clone content to remove any nested anchor links (#)
        const clone = actualHeading.cloneNode(true);
        clone.querySelectorAll("a, .anchor-link").forEach((el) => el.remove());
        // Set HTML to preserve the <img> tags from twemoji
        a.innerHTML = clone.innerHTML;
      } else {
        a.innerText = h.text; // Fallback to plain text
      }
      // -------------------------

      li.appendChild(a);
      list.appendChild(li);
    });

    container.appendChild(title);
    container.appendChild(list);
  }

  document.addEventListener("astro:page-load", setupTableOfContents);

  const katexFontUrls = import.meta.glob("/node_modules/katex/dist/fonts/*", {
    eager: true,
    import: "default",
    query: "?url",
  }) as Record<string, string>;
  const katexFontUrlByName = Object.fromEntries(
    Object.entries(katexFontUrls).map(([path, url]) => [
      path.split("/").pop(),
      url,
    ]),
  );

  document.addEventListener("astro:page-load", () => {
    const mathElements = document.querySelectorAll(".katex");
    if (mathElements.length === 0) return;

    let stylesheetPromise: Promise<void> | undefined;
    let observer: IntersectionObserver | undefined;

    const loadKatexStylesheet = () => {
      stylesheetPromise ??= import("katex/dist/katex.min.css?raw").then(
        ({ default: css }) => {
          if (document.getElementById("katex-stylesheet")) return;

          const stylesheet = document.createElement("style");
          stylesheet.id = "katex-stylesheet";
          stylesheet.textContent = css.replace(
            /url\((["']?)fonts\/([^"')]+)\1\)/g,
            (match, quote, fontName) => {
              const fontUrl = katexFontUrlByName[fontName];
              return fontUrl ? `url(${quote}${fontUrl}${quote})` : match;
            },
          );
          document.head.append(stylesheet);
        },
      );
      observer?.disconnect();
    };

    if ("IntersectionObserver" in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            loadKatexStylesheet();
          }
        },
        { rootMargin: "800px 0px" },
      );

      mathElements.forEach((element) => observer?.observe(element));
      document.addEventListener(
        "astro:before-swap",
        () => observer?.disconnect(),
        { once: true },
      );
    } else {
      loadKatexStylesheet();
    }
  });
</script>
