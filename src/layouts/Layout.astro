---
import { LOCALES, DEFAULT_LOCALE, type Lang } from "@/types/i18n";

import { LOCALES_SETTING } from "@/i18n/locales";
import { useTranslator } from "@/i18n/utils";

import defaultOgpImage from "@/assets/og-default.png";
import type { ImageMetadata } from "astro";

import GoogleAnalytics from "@/components/GoogleAnalytics.astro";
import { SITE_TITLE } from "@/consts";
import { ClientRouter } from "astro:transitions";

const lang = (Astro.currentLocale ||
  DEFAULT_LOCALE) as keyof typeof LOCALES_SETTING;
const t = useTranslator(lang);
const langFull = LOCALES_SETTING[lang]?.lang;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article" | "profile" | "book" | "music" | "video";
  ogpImage?: URL | ImageMetadata;
  disableTrailingWebsiteName?: Boolean;
  alternateLocales?: Partial<Record<keyof typeof LOCALES_SETTING, string>>;
}

const defaultOgpImageUrl = new URL(defaultOgpImage.src, Astro.site);
const siteName = t("site-name");
const {
  title = siteName,
  description = t("site-description"),
  type = "website",
  ogpImage = defaultOgpImageUrl,
  disableTrailingWebsiteName = false,
  alternateLocales,
} = Astro.props;

const displayedTitle = !disableTrailingWebsiteName
  ? `${title} | ${siteName}`
  : title;

const displayedOgpImage =
  "src" in ogpImage ? new URL(ogpImage.src, Astro.site) : ogpImage;

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang={langFull}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL} />
    {
      alternateLocales &&
        Object.entries(alternateLocales).map(([locale, path]) => (
          <link
            rel="alternate"
            hreflang={LOCALES_SETTING[locale]?.lang ?? locale}
            href={new URL(path, Astro.site)}
          />
        ))
    }
    {
      alternateLocales?.[DEFAULT_LOCALE] && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternateLocales[DEFAULT_LOCALE], Astro.site)}
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <title>{displayedTitle}</title>
    <meta name="description" slot="head" content={description} />
    <meta property="og:title" content={displayedTitle} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={displayedOgpImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={displayedOgpImage} />
    <meta property="og:locale" content={langFull?.replace("-", "_")} />
    <meta property="og:url" content={Astro.url} />
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      };

      const applyTheme = () => {
        const theme = getThemePreference();

        document.documentElement.classList.toggle("dark", theme === "dark");
      };

      document.addEventListener("astro:after-swap", applyTheme);
      applyTheme();
    </script>
  </head>
  <body>
    <main id="main-content">
      <slot />
    </main>
    <GoogleAnalytics />
    {
      isDev && (
        <script>
          const scrollKey = `aosankaku:dev-scroll:${window.location.pathname}${window.location.search}`;

          const getScrollPosition = () => {
            const scrollingElement = document.scrollingElement;

            return {
              x: Math.max(
                window.scrollX,
                document.documentElement.scrollLeft,
                document.body.scrollLeft,
                scrollingElement?.scrollLeft ?? 0,
              ),
              y: Math.max(
                window.scrollY,
                document.documentElement.scrollTop,
                document.body.scrollTop,
                scrollingElement?.scrollTop ?? 0,
              ),
            };
          };

          const saveScrollPosition = () => {
            const { x, y } = getScrollPosition();

            sessionStorage.setItem(
              scrollKey,
              JSON.stringify({
                x,
                y,
                href: window.location.href,
                savedAt: Date.now(),
              }),
            );
          };

          const scrollToPosition = (x, y) => {
            window.scrollTo(x, y);

            document.documentElement.scrollLeft = x;
            document.documentElement.scrollTop = y;
            document.body.scrollLeft = x;
            document.body.scrollTop = y;

            if (document.scrollingElement) {
              document.scrollingElement.scrollLeft = x;
              document.scrollingElement.scrollTop = y;
            }
          };

          const restoreScrollPosition = () => {
            const savedValue = sessionStorage.getItem(scrollKey);
            if (!savedValue) return;

            sessionStorage.removeItem(scrollKey);

            try {
              const saved = JSON.parse(savedValue);
              if (
                saved.href !== window.location.href ||
                Date.now() - saved.savedAt > 30_000
              ) {
                return;
              }

              if ("scrollRestoration" in window.history) {
                window.history.scrollRestoration = "manual";
              }

              const restore = () => scrollToPosition(saved.x, saved.y);

              requestAnimationFrame(() => {
                restore();
                setTimeout(restore, 50);
                setTimeout(restore, 250);
              });
            } catch {
              // Ignore stale or invalid development-only state.
            }
          };

          let saveScrollFrame = 0;
          const scheduleScrollPositionSave = () => {
            if (saveScrollFrame) return;

            saveScrollFrame = requestAnimationFrame(() => {
              saveScrollFrame = 0;
              saveScrollPosition();
            });
          };

          if (import.meta.hot) {
            import.meta.hot.on("vite:beforeFullReload", saveScrollPosition);
          }

          window.addEventListener("beforeunload", saveScrollPosition);
          window.addEventListener("pagehide", saveScrollPosition);
          window.addEventListener("scroll", scheduleScrollPositionSave, {
            passive: true,
          });
          document.body.addEventListener("scroll", scheduleScrollPositionSave, {
            passive: true,
          });
          restoreScrollPosition();
        </script>
      )
    }
  </body>
</html>

<style>
  html,
  body {
    font-family: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", "YuGothic", "Meiryo", "Noto Sans JP", sans-serif;
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-background);
    color: var(--color-text);
    max-width: 100vw;
    overflow-x: hidden;
    line-height: 1.5;
    transition:
      background-color 0.5s ease,
      color 0.5s ease;
  }

  :global(a) {
    color: var(--color-primary);
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(h4),
  :global(h5),
  :global(h6),
  :global(p),
  :global(li),
  :global(a) {
    line-height: 1.6;
  }

  :global(code) {
    background: color-mix(in srgb, var(--color-card), transparent 50%);
    padding: 2px 6px;
    border-radius: 4px;
    margin: 0 2px;
  }

  /* Light theme */
  :root {
    --color-text: #1a1a1a;
    --color-text-sub: rgba(26, 26, 26, 0.75);
    --color-background: #ffffff;
    --color-primary: #0056b3;
    --color-surface: #f4f4f4;
    --color-card: #bebebe;
    --color-blogcard: #ebebeb;

    --color-note: #0969da;
    --color-note-bg: rgba(9, 105, 218, 0.1);
    --color-tip: #1a7f37;
    --color-tip-bg: rgba(26, 127, 55, 0.1);
    --color-important: #8250df;
    --color-important-bg: rgba(130, 80, 223, 0.1);
    --color-warning: #9a6700;
    --color-warning-bg: rgba(154, 103, 0, 0.1);
    --color-caution: #d1242f;
    --color-caution-bg: rgba(209, 36, 47, 0.1);
  }

  /* Dark theme */
  .dark {
    --color-text: #f0f0f0;
    --color-text-sub: rgba(240, 240, 240, 0.75);
    --color-background: #1a1a1a;
    --color-primary: #8ab4f8;
    --color-surface: #2c2c2c;
    --color-card: #696969;
    --color-blogcard: #3d3d3d;

    --color-note: #4493f8;
    --color-tip: #3fb950;
    --color-important: #a371f7;
    --color-warning: #d29922;
    --color-caution: #f85149;
  }
</style>

<style is:global>
  /* This will apply to EVERY .twemoji img on your site, 
     regardless of where it was generated */
  img[data-twemoji] {
    height: 1.2em !important;
    width: 1.2em !important;
    margin: 0 0.05em 0 0.1em !important;
    vertical-align: -0.2em !important;
    display: inline-block !important;
    border: none !important; /* Remove any default image borders */
    box-shadow: none !important;
    user-select: text !important;
  }
</style>
